# PostHog configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# Anthropic (used by /api/review, the landing page review)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Supabase (backs the rate limiter in lib/rate-limit.ts — see supabase/rate-limit.sql)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Secret key, server only: writes the private Second Opinion log (lib/review-log.ts)
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Optional: total landing page reviews allowed per day across the site (default 60)
ROAST_DAILY_LIMIT=60

# Resend (sends contact form messages to you; see app/api/contact/route.ts)
RESEND_API_KEY=your_resend_api_key
# Must be the email you signed up to Resend with, until you verify your domain there
CONTACT_TO_EMAIL=you@example.com
