# PostHog configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# Anthropic (used by /api/roast)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Supabase (backs the rate limiter in lib/rate-limit.ts — see supabase/rate-limit.sql)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
