# Anthropic — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Neon Postgres — get from Neon dashboard → Connection string
DATABASE_URL=postgres://neondb_owner:...@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Google OAuth — get from console.cloud.google.com → APIs & Services → Credentials
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# NextAuth secret — run: openssl rand -base64 32
AUTH_SECRET=your-random-secret-here
