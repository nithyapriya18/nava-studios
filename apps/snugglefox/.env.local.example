# Story generation (Claude)
ANTHROPIC_API_KEY=
STORY_PROVIDER=anthropic
STORY_MODEL=claude-haiku-4-5

# Narration (OpenAI TTS)
OPENAI_API_KEY=
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts

# Database (Neon Postgres, free tier is fine)
DATABASE_URL=

# Where generated audio files are kept
AUDIO_STORAGE=local
